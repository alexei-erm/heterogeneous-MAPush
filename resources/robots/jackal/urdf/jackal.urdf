<?xml version="1.0"?>
<!--
Simplified Jackal URDF for Isaac Gym
Differential drive wheeled robot with 2 DOF (left_wheel, right_wheel velocities)
Original: Clearpath Robotics Jackal
Simplified for MAPush heterogeneous agent training
-->
<robot name="jackal">

  <!-- Materials -->
  <material name="dark_grey">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>
  <material name="black">
    <color rgba="0.15 0.15 0.15 1.0"/>
  </material>

  <!-- Base link (reference frame) -->
  <link name="base_link"/>

  <!-- Chassis link -->
  <link name="chassis_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="jackal-base.stl" scale="1 1 1"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.046" rpy="0 0 0"/>
      <geometry>
        <box size="0.420 0.310 0.184"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.012 0 0.067" rpy="0 0 0"/>
      <mass value="16.523"/>
      <inertia ixx="0.56568" ixy="0" ixz="0" iyy="0.50845" iyz="0" izz="0.88143"/>
    </inertial>
  </link>

  <!-- Fixed joint: base_link to chassis_link -->
  <joint name="base_link_joint" type="fixed">
    <origin xyz="0 0 0.0655" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="chassis_link"/>
  </joint>

  <!-- Left drive wheel (actuated) -->
  <link name="left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="jackal-wheel.stl" scale="1 1 1"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.098" length="0.040"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.477"/>
      <inertia ixx="0.0013" ixy="0" ixz="0" iyy="0.0024" iyz="0" izz="0.0013"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="chassis_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="0 0.18779 0.0345" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="10.0" velocity="20.0"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <!-- Right drive wheel (actuated) -->
  <link name="right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="jackal-wheel.stl" scale="1 1 1"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.098" length="0.040"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.477"/>
      <inertia ixx="0.0013" ixy="0" ixz="0" iyy="0.0024" iyz="0" izz="0.0013"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="chassis_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="0 -0.18779 0.0345" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="10.0" velocity="20.0"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <!-- Caster wheels (passive, for stability in simulation) -->
  <link name="front_caster_link">
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="front_caster_joint" type="fixed">
    <parent link="chassis_link"/>
    <child link="front_caster_link"/>
    <origin xyz="0.131 0 -0.02" rpy="0 0 0"/>
  </joint>

  <link name="rear_caster_link">
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="rear_caster_joint" type="fixed">
    <parent link="chassis_link"/>
    <child link="rear_caster_link"/>
    <origin xyz="-0.131 0 -0.02" rpy="0 0 0"/>
  </joint>

</robot>
