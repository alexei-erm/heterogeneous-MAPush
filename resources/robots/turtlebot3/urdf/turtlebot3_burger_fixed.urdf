<?xml version="1.0" ?>
<!--
  Turtlebot3 Burger - Fixed for Isaac Gym
  Changes:
  - Removed base_footprint (massless virtual link causes NaN)
  - base_link is now the root
  - Added explicit limits/efforts to continuous joints
  - Increased wheel masses for stability
  - Added small inertia to caster
-->
<robot name="turtlebot3_burger">

  <material name="black">
      <color rgba="0.0 0.0 0.0 1.0"/>
  </material>

  <material name="dark">
    <color rgba="0.3 0.3 0.3 1.0"/>
  </material>

  <material name="light_black">
    <color rgba="0.4 0.4 0.4 1.0"/>
  </material>

  <!-- Base link is now the root (no base_footprint) -->
  <link name="base_link">
    <visual>
      <origin xyz="-0.032 0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/bases/burger_base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="light_black"/>
    </visual>

    <collision>
      <origin xyz="-0.032 0 0.070" rpy="0 0 0"/>
      <geometry>
        <box size="0.140 0.140 0.143"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>  <!-- Increased from 0.826 for stability -->
      <inertia ixx="2.2124416e-03" ixy="-1.2294101e-05" ixz="3.4938785e-05"
               iyy="2.1193702e-03" iyz="-5.0120904e-06" izz="2.0064271e-03" />
    </inertial>
  </link>

  <!-- Left wheel with explicit limits -->
  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_left_link"/>
    <origin xyz="0.0 0.08 0.023" rpy="-1.57 0 0"/>
    <axis xyz="0 0 1"/>
    <!-- Add explicit limits for continuous joint -->
    <limit effort="10.0" velocity="20.0"/>
  </joint>

  <link name="wheel_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57 0 0"/>
      <geometry>
        <mesh filename="../meshes/wheels/left_tire.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.018" radius="0.033"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.1" />  <!-- Increased from 0.028 for stability -->
      <inertia ixx="1.1175580e-05" ixy="0.0" ixz="0.0"
               iyy="1.1192413e-05" iyz="0.0" izz="2.0712558e-05" />
    </inertial>
  </link>

  <!-- Right wheel with explicit limits -->
  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_right_link"/>
    <origin xyz="0.0 -0.080 0.023" rpy="-1.57 0 0"/>
    <axis xyz="0 0 1"/>
    <!-- Add explicit limits for continuous joint -->
    <limit effort="10.0" velocity="20.0"/>
  </joint>

  <link name="wheel_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57 0 0"/>
      <geometry>
        <mesh filename="../meshes/wheels/right_tire.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.018" radius="0.033"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.1" />  <!-- Increased from 0.028 for stability -->
      <inertia ixx="1.1175580e-05" ixy="0.0" ixz="0.0"
               iyy="1.1192413e-05" iyz="0.0" izz="2.0712558e-05" />
    </inertial>
  </link>

  <!-- Caster (simplified - using sphere instead of box) -->
  <joint name="caster_back_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_back_link"/>
    <origin xyz="-0.081 0 0.005" rpy="0 0 0"/>
  </joint>

  <link name="caster_back_link">
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.015"/>  <!-- Sphere is more stable than box -->
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.05" />  <!-- Increased from 0.005 -->
      <inertia ixx="1e-5" ixy="0.0" ixz="0.0"
               iyy="1e-5" iyz="0.0" izz="1e-5" />
    </inertial>
  </link>

</robot>
